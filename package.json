		"@vite-pwa/sveltekit": "^1.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "5.5.x",
		"vite": "^6.0.0"
	},
	"type": "module",
	"dependencies": {
		"mongoose": "8.17.x"
	}
}
